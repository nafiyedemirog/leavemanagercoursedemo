#!/bin/sh
# Runs the project's virtualenv Python (.venv), Windows or POSIX layout.
# Used by scripts/check.conf so check never depends on an activated shell.
root=$(cd "$(dirname "$0")/.." && pwd)
for p in "$root/.venv/Scripts/python.exe" "$root/.venv/bin/python"; do
  if [ -x "$p" ]; then exec "$p" "$@"; fi
done
echo "tools/py: .venv not found — see backend/README.md (Kurulum)" >&2
exit 127
